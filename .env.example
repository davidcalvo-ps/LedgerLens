# Copy to .env and replace the placeholder values. Never commit .env.

# PostgreSQL
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Core API (Django)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
# Session and CSRF cookies are Secure-only unless this is false (plain-HTTP local dev).
DJANGO_SECURE_COOKIES=false
# Extra origins allowed to send unsafe requests, comma-separated (e.g. https://demo.example).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Password for every demo user created by `scripts/dev.sh seed`.
LEDGERLENS_DEMO_PASSWORD=change-me-demo-password
CORE_API_PORT=8000
