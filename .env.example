# Copy to .env and replace the placeholder values. Never commit .env.

# PostgreSQL
POSTGRES_DB=ledgerlens
POSTGRES_USER=ledgerlens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Core API (Django)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
CORE_API_PORT=8000
